@startuml
participant GameLoop
participant CGameInstance as GI
participant CObject_Manager as OM
participant CGameObject as Obj
participant CRenderer as Renderer
participant CRenderTargetManager as RTM
participant CLightManager as Lights

GameLoop -> GI : UpdateEngine(dt)
GI -> OM : PriorityUpdate(dt)
GI -> GI : PipeLine.Update()
GI -> GI : Frustum.Update()
GI -> OM : Update(dt)
GI -> OM : LateUpdate(dt)
OM -> Obj : LateUpdate(dt)
Obj -> GI : AddRenderObject(group, this)
GI -> Renderer : AddRenderObject(group, this)

GameLoop -> GI : Draw()
GI -> Renderer : DrawRenderObject()
Renderer -> RTM : BeginMRT(MRTShadow)
Renderer -> Obj : RenderShadow()
Renderer -> RTM : EndMRT()
Renderer -> RTM : BeginMRT(MRTGameObjects)
Renderer -> Obj : Render()
Renderer -> RTM : EndMRT()
Renderer -> RTM : BeginMRT(MRTLightAcc)
Renderer -> Lights : Render(shader, fullscreenQuad)
Renderer -> RTM : EndMRT()
Renderer -> Renderer : Composite / Glow / Distortion / UI
@enduml
