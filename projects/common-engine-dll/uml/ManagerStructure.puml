@startuml
skinparam classAttributeIconSize 0

title 주요 Manager 의존 구조

class CGameInstance <<Singleton>> {
  +InitializeEngine()
  +UpdateEngine(dt)
  +Draw()
  +AddPrototype(level, tag, proto)
  +ClonePrototype(type, level, tag, arg)
  +AddGameObjectToLayer(...)
  +AddRenderObject(group, object)
}
class CPrototype_Manager {
  -map<wstring, CBase*>* m_pPrototypes
  +AddPrototype()
  +ClonePrototype()
  +Clear(level)
}
class CObject_Manager {
  -map<wstring, CLayer*>* m_pLayers
  +AddGameObjectToLayer()
  +SpawnObject()
  +FindLayer()
  +PriorityUpdate()
  +Update()
  +LateUpdate()
}
class CLayer {
  -list<CGameObject*> m_GameObjects
  +AddGameObject()
  +GetComponent()
  +CheckIntersect()
}
class CRenderer {
  -list<CGameObject*> m_RenderObjects[RG_END]
  +AddRenderObject()
  +DrawRenderObject()
}
class CRenderTargetManager
class CLevel_Manager
class CUIManager

CGameInstance --> CPrototype_Manager : 원형 등록/복제 API 제공
CGameInstance --> CObject_Manager : 오브젝트 생성/조회 API 제공
CGameInstance --> CRenderer : 렌더 그룹 등록/Draw 호출
CGameInstance --> CRenderTargetManager : RenderTarget / MRT 래핑
CGameInstance --> CLevel_Manager : 현재 레벨 관리
CGameInstance --> CUIManager : UI 등록/조회 래핑
CObject_Manager *-- CLayer : 레벨별 Layer 소유
CLayer o-- CGameObject : GameObject 목록 보관
@enduml
