@startuml
title Feature Toggle Architecture - 기능 토글 아키텍처

interface IFeatureModule {
  +Initialize()
  +Enable()
  +Disable()
  +Reset()
  +Tick()
  +CaptureBeforeState()
  +CaptureAfterState()
  +GetDebugData()
  +GetMetrics()
}

abstract class FeatureModuleBase {
  -bool isEnabled
  -FeatureModuleState state
  +Initialize()
  +Enable()
  +Disable()
  +Reset()
  +Tick()
  +GetState()
  +GetMetrics()
}

class FeatureToggleManager {
  -List<IFeatureModule> modules
  +RegisterModule(IFeatureModule module)
  +EnableModule(string id)
  +DisableModule(string id)
  +ToggleModule(string id)
  +GetActiveModules()
}

class ModuleDependencyResolver {
  +CanEnable(IFeatureModule module)
  +GetMissingDependencies(IFeatureModule module)
}

class ModuleMetricsProvider {
  +CollectMetrics(IFeatureModule module)
}

class SkillSystemModule
class SkillEditorModule
class AnimationToolModule
class ShaderShowcaseModule
class OptimizationShowcaseModule
class RenderingDebugViewModule

IFeatureModule <|.. FeatureModuleBase : 구현
FeatureModuleBase <|-- SkillSystemModule : 스킬 런타임 모듈
FeatureModuleBase <|-- SkillEditorModule : 스킬 툴 모듈
FeatureModuleBase <|-- AnimationToolModule : 애니메이션 툴 모듈
FeatureModuleBase <|-- ShaderShowcaseModule : 셰이더 시연 모듈
FeatureModuleBase <|-- OptimizationShowcaseModule : 최적화 시연 모듈
FeatureModuleBase <|-- RenderingDebugViewModule : 렌더링 디버그 모듈

FeatureToggleManager --> IFeatureModule : 모듈 등록/토글
FeatureToggleManager --> ModuleDependencyResolver : 의존성 확인
FeatureToggleManager --> ModuleMetricsProvider : 성능 지표 수집

@enduml
