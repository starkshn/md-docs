@startuml
title Lua Skill Formula Sequence - Lua 데미지 공식 실행 흐름

actor Player
participant NY_Skill_Instance
participant NY_Scripting_Gateway
participant NY_Scripting_Context
participant NY_Scripting_LuaRuntime
participant damage_formula_lua
participant NY_Scripting_Result
participant NY_Scripting_Metrics
participant NY_Scripting_ErrorReporter

Player -> NY_Skill_Instance : Skill Execute
NY_Skill_Instance -> NY_Scripting_Gateway : ExecuteFormula(scriptId, data)
NY_Scripting_Gateway -> NY_Scripting_Context : Create Context
NY_Scripting_Gateway -> NY_Scripting_LuaRuntime : Run(scriptId, context, timeout)
NY_Scripting_LuaRuntime -> damage_formula_lua : Execute

damage_formula_lua --> NY_Scripting_LuaRuntime : damage value
NY_Scripting_LuaRuntime --> NY_Scripting_Result : success / value / elapsedMs
NY_Scripting_Result --> NY_Scripting_Gateway : result
NY_Scripting_Gateway -> NY_Scripting_Metrics : Record success / elapsedMs
NY_Scripting_Gateway --> NY_Skill_Instance : formula result

alt Lua Error or Timeout
  NY_Scripting_LuaRuntime --> NY_Scripting_Result : fail / errorCode
  NY_Scripting_Result --> NY_Scripting_Gateway : error result
  NY_Scripting_Gateway -> NY_Scripting_ErrorReporter : Report error
  NY_Scripting_Gateway -> NY_Scripting_Metrics : Record failure
  NY_Scripting_Gateway --> NY_Skill_Instance : fallback C# formula result
end

@enduml
