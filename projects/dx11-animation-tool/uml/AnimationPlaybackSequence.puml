@startuml
title Animation 재생과 Bone Matrix 갱신 흐름

participant CGameObject as Obj
participant CModel as Model
participant CAnimation as Anim
participant CChannel as Channel
participant CBone as Bone
participant CShader as Shader

Obj -> Model : SetupAnimation(index, playType)
loop 매 프레임
  Obj -> Model : PlayAnimation(dt)
  Model -> Anim : UpdateTransformationMatrices(bones, loop, dt)
  loop 모든 Channel 순회
    Anim -> Channel : UpdateTransformationMatrix(trackPos, keyIndex, bones)
    Channel -> Bone : Local Transform 갱신
  end
  Model -> Bone : Combined Matrix 갱신
end
Obj -> Model : BindBoneMatrices(shader, constant, meshIndex)
Model -> Shader : Bone Matrix 배열 바인딩
Obj -> Model : Render(meshIndex)
@enduml
