@startuml
start
:Pick weekly milestone;
:Implement Runtime slice;
if (Needs data?) then (yes)
  :Create/Update ScriptableObject schema;
endif
if (Needs tool?) then (yes)
  :Add EditorWindow or Inspector UI;
endif
:Create demo scene interaction;
:Add validation and debug UI;
