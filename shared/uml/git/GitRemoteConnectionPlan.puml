@startuml GitRemoteConnectionPlan
!theme plain
title Git Remote 연결 계획

skinparam defaultFontName Malgun Gothic
skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333

package "문서 저장소" {
  component "로컬\ntechnical-portfolio-docs" as LocalDocs
  component "origin\ntechnical-portfolio-docs.git\n기존 계획 remote" as OriginDocs
  component "md-docs\nmd-docs.git\n현재 활성 remote" as MdDocs
}

package "Unity 저장소" {
  component "로컬\nunity-technical-showcase" as LocalUnity
  component "origin\nUnity GitHub URL\n나중에 연결" as RemoteUnity
}

package "공개 사이트 저장소" {
  component "로컬\nstarkshn.github.io" as LocalSite
  component "origin\nstarkshn.github.io.git\n이미 연결됨" as RemoteSite
}

LocalDocs --> OriginDocs : remote 유지
LocalDocs --> MdDocs : push / pull 기준
LocalUnity ..> RemoteUnity : GitHub repo 생성 후 연결
LocalSite --> RemoteSite : GitHub Pages 배포

note right of MdDocs
현재 문서 push 명령

git -C C:\\kny\\technical-portfolio-docs push md-docs main
end note

note right of RemoteUnity
나중에 연결

git -C C:\\kny\\Project\\Unity\\unity-technical-showcase remote add origin <URL>
git -C C:\\kny\\Project\\Unity\\unity-technical-showcase push -u origin main
end note

note right of RemoteSite
공개 포트폴리오 사이트
블로그 링크 / 데모 링크 관리
end note

@enduml
