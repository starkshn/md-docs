@startuml
title Unity Skill 실행 시퀀스

actor Player as "입력 주체"
participant SkillController
participant SkillFactory
participant SkillInstance
participant ConditionModule
participant CooldownModule
participant TargetResolver
participant EffectModule
participant AnimationEventDispatcher

Player -> SkillController : TryExecute(skillId)
SkillController -> SkillFactory : GetOrCreate(definition)
SkillFactory --> SkillController : SkillInstance 반환
SkillController -> SkillInstance : Execute(context)
SkillInstance -> ConditionModule : CanExecute(context)
SkillInstance -> CooldownModule : IsReady(context)
SkillInstance -> TargetResolver : Resolve(context)
TargetResolver --> SkillInstance : targets 반환
SkillInstance -> AnimationEventDispatcher : 시전 Animation 재생 / Event 대기
AnimationEventDispatcher --> SkillInstance : OnSkillImpact
loop 모든 target 처리
  SkillInstance -> EffectModule : Apply(context, target)
end
SkillInstance -> CooldownModule : Consume(context)
@enduml
